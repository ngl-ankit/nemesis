# Copy to nemesis/.env for local development (never commit the real file).
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Reasoning models (openai/gpt-oss-20b, gpt-oss-120b, o-series) need this set to
# "low" so hidden reasoning does not consume the whole reply budget. Leave blank
# for non-reasoning models such as llama-3.3-70b-versatile.
GROQ_REASONING_EFFORT=low
SECRET_KEY=change-me-for-local
FLASK_ENV=development
# DATABASE_URL=postgresql://user:pass@host:5432/nemesis   # leave unset to use SQLite
# DATABASE_PATH=./nemesis.db
# ADMIN_ENABLED=true
# ADMIN_TOKEN=some-long-random-string
# CORS_ORIGINS=
