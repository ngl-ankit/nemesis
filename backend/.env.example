# Copy to backend/.env for local development (never commit the real file).
# Nemesis uses openai/gpt-oss-20b via an OpenAI-compatible endpoint (Groq by default).
LLM_API_KEY=your_provider_api_key_here
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_REASONING_EFFORT=low

SECRET_KEY=change-me-for-local
FLASK_ENV=development
SESSION_DAYS=30
# DISABLE_REGISTRATION=true

# DATABASE_URL=postgresql://user:pass@host:5432/nemesis   # leave unset to use SQLite
# DATABASE_PATH=./nemesis.db
# CORS_ORIGINS=
# ADMIN_ENABLED=true
# ADMIN_TOKEN=some-long-random-string
# LOG_LEVEL=INFO
